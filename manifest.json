{
    "manifest_version": 3,
    "name": "VisionFlow AI",
    "version": "1.0",
    "description": "Voice-guided accessible web navigation.",

    "permissions": [
        "activeTab",
        "scripting",
        "sidePanel",
        "tabs"
    ],

    "host_permissions": [
        "*://*/*"
    ],

    "side_panel": {
        "default_path": "sidepanel.html"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["js/core/content.js"],
            "run_at": "document_idle"
        }
    ],

    "background": {
        "service_worker": "js/core/background.js"
    },

    "action": {
        "default_icon": {
            "16": "image/icon16.png",
            "32": "image/icon32.png",
            "48": "image/icon32.png"
        }
    },

    "icons": {
        "16": "image/icon16.png",
        "32": "image/icon32.png",
        "48": "image/icon32.png",
        "128": "image/icon128.png"
    }
}