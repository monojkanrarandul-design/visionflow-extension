{
    "manifest_version": 3,
    "name": "VisionFlow AI",
    "version": "1.0",
    "description": "Voice-guided accessible web navigation.",
    "permissions": ["activeTab", "scripting", "sidePanel","tabs"],
    "host_permissions":[
        "*://*/*"
    ],
    "side_panel":{
        "default_path": "sidepanel.html"
    },


    "icons": {
        "16": "image/icon16.png",
        "32": "image/icon32.png",
        "48": "image/icon32.png",
        "128": "image/icon128.png"
    },

  "action": {
    "default_title": "Open VisionFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "image/icon16.png",
      "32": "image/icon32.png",
      "48": "image/icon32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["js/tools/pageHtml.js"]
    }
  ]
}